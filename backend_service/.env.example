# Backend Service - Example Environment Variables
# Copy this file to ".env" and adjust values for your environment.

# Environment mode: development | staging | production
ENV=development

# CORS allowed origins: comma-separated values. Use "*" for all origins (development only).
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ALLOW_ORIGINS=*

# Base site URL used by backend to build OAuth redirect URIs.
# Should point to where this FastAPI service is reachable.
# In local dev when running uvicorn on port 3001:
SITE_URL=http://localhost:3001

# Admin API key required for /admin/registry endpoints.
# Change this to a secure value in non-dev environments.
ADMIN_API_KEY=change-me

# Token encryption key placeholder (do not use in production; use a KMS or secret manager)
TOKEN_ENCRYPTION_KEY=dev-not-secure
