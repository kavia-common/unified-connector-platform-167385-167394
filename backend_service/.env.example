# Backend Service environment variables
# Copy this file to .env and set appropriate values for your environment.

# Environment name: development | staging | production
ENV=development

# CORS allowed origins as a comma-separated list. Use "*" for all origins in development.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Rate limit configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Base site URL for OAuth redirect construction (frontend base URL)
SITE_URL=http://localhost:3000

# Token encryption key (do NOT use default in production; use a secure secret or KMS)
TOKEN_ENCRYPTION_KEY=dev-not-secure

# Admin API key required for /admin/registry endpoints
ADMIN_API_KEY=change-me
