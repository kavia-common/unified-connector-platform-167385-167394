                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth/callback": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Complete OAuth callback",
        "description": "Complete OAuth flow by exchanging authorization code for an access token.\n\nParameters:\n- tenant_id, provider, code, state\n\nReturns:\n- token_id referencing the stored token",
        "operationId": "oauth_callback_auth_oauth_callback_post",
        "requestBody": {
          "content": {
            "application/json": {
