{
  "openapi": "3.1.0",
  "info": {
    "title": "Unified Connector Platform API",
    "description": "A unified API to authenticate, connect, and interact with third-party providers (e.g., Jira, Confluence) via API Key or OAuth, manage connectors per tenant, operate on provider resources, leverage LLM tools proxy, and manage a connector registry.",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/api-key": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate with API Key",
        "description": "Authenticate a tenant with a provider using API key.\n\nParameters:\n- tenant_id: Tenant performing authentication\n- provider: Provider name\n- api_key: Provider API key\n- label: Optional label for token\n\nReturns:\n- token_id referencing the stored token",
        "operationId": "auth_api_key_auth_api_key_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APIKeyAuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIKeyAuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/oauth/init": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Initiate OAuth flow",
        "description": "Initiate an OAuth flow for a provider.\n\nThe response contains an authorization_url and a state value.\nThe client should redirect the user-agent to the authorization_url.",
        "operationId": "oauth_init_auth_oauth_init_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthInitRequest"
              }
            }
          },
          "required": true
